{
  "name": "wakefield-pool-championship-sites",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-sites.mjs",
    "test": "node scripts/build-sites.mjs && node --test --test-isolation=none tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "build:netlify": "node scripts/build-netlify.mjs",
    "db:generate:netlify": "drizzle-kit generate --config drizzle.netlify.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-kit": "^1.0.0-beta.22",
    "drizzle-orm": "^1.0.0-beta.22",
    "netlify-cli": "^27.16.3"
  },
  "dependencies": {
    "@netlify/database": "^2.0.3"
  }
}
